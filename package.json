{
  "name": "event-driven-architecture",
  "version": "1.0.1",
  "description": "A event driven archetecture api",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsc index.ts",
    "dev": "tsc --noEmit --watch index.ts",
    "test": "npx tsx --test 'test/**/*.spec.ts' --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info",
    "test:coverage": "c8 --reporter=html --reporter=text npm test"
  },
  "keywords": [
    "event-driven",
    "socket",
    "api"
  ],
  "author": "@lukaswilkeer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/socket.io-client": "^1.4.36",
    "c8": "^12.0.0",
    "eslint": "^8.7.0",
    "glob": "^13.0.6",
    "gulp": "^4.0.2",
    "socket.io-client": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "jsonwebtoken": "^8.5.1",
    "socket.io": "^2.3.0"
  }
}
