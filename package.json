    "glob": "^13.0.6",
    "gulp": "^4.0.2",
    "socket.io-client": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "jsonwebtoken": "^8.5.1",
    "socket.io": "^2.3.0"
