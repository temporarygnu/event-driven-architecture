{
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "sourceMap": true,
    "allowJs": false,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "isolatedModules": true,
  },

  "include": ["./*.ts", "./src/**/*", "./test/**/*.ts"]
}
